# /etc/cdt-guard.env   (chmod 600, root)
# ── 阿里云 RAM 用户 ──
ALI_AK=LTAIxxxxxxxxxxxxxxxx
ALI_SK=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALI_REGION=cn-hongkong
ALI_INSTANCE_ID=i-xxxxxxxxxxxxxxxxxxxx

# ── 流量 ──
# 免费额度：香港+海外共用 200GB，中国内地 20GB（按 ALI_REGION 自动判断，一般不用改）
# CDT_QUOTA_GB=200
CDT_LIMIT_GB=199          # 实际用量 ≥ 这个就熔断
CDT_LOOKAHEAD_MIN=30      # 按近 1h 速率预测，30 分钟内会过线也提前熔断（弥补 CDT 数据延迟）
# CDT_RELEASE_GB=189      # 熔断后流量掉到这以下才解除（默认 LIMIT-10，实际就是每月 1 号重置）

# ── 熔断方式 ──
# stop：关机。sg：不关机，在实例安全组加一条优先级 1 的 drop-all 入站规则
GUARD_MODE=stop
# 按量付费才有效：KeepCharging 保留公网 IP、开机不会缺库存；StopCharging 省算力钱，但 IP 会变、开机可能 NoStock
STOP_MODE=KeepCharging
# sg 模式用哪个安全组，不填就用实例的第一个安全组
# SG_ID=sg-xxxxxxxx

# 发现实例被停（抢占回收、手动误关、平台维护）就自动开机。手动维护前跑 `cdt_guard.py hold`
GUARD_KEEPALIVE=1

# ── 通知（可直接用 traffic-bot 的 BOT_TOKEN 和 ALLOWED_CHAT_IDS；多个 chat 用逗号分隔）──
TG_BOT_TOKEN=
TG_CHAT_ID=

STATE_DIR=/var/lib/cdt-guard
