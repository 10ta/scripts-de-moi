# /etc/warp-keeper.env  （权限 600，只有 root 能读）
# 改完运行一次 /opt/warp-keeper/warp-keeper.sh init 让 sing-box 用上新配置（沿用现有账户，不换号）

# 面板和 Telegram 里显示的名字，默认主机名。多台机器都装时用它区分
#WARP_NAME=

# ---------- sing-box ----------
# endpoint 的 tag：你的路由规则用这个名字把流量送进 WARP。和主配置里任何 tag 都不能重名
WARP_TAG="🧩 <WARP>"

# 本机 mixed 入站（只监听 127.0.0.1，socks5 / http 都行），流量全部走 WARP。两个用途：
#   1. warp-keeper 用它探测 WARP 通不通
#   2. 顶替原来 wireproxy 的 socks5 地址：原来指向 socks5://127.0.0.1:18650 的东西不用改
LOCAL_PORT=18650

# 走 WARP 的协议栈：dual（IPv4 + IPv6）/ v4 / v6。探测也按这个来，每个栈都通才算正常
STACK=dual

# WireGuard MTU。1280 最保险（底层是 IPv6 也不会分片）；想要一点吞吐可以试 1420，慢或断流就调回来
MTU=1280

# 连 Cloudflare 的哪个地址：auto = 注册时 Cloudflare 分配的 IP（本机有 IPv4 默认路由用 v4，否则用 v6）
#PEER=auto
# 端口：2408 被运营商干扰时可以换 500 / 1701 / 4500
#PEER_PORT=2408
#KEEPALIVE=30

# sing-box 的 systemd 服务名，和它的配置目录（留空 = 从服务的启动参数里读 -C 后面的目录）
#SB_SERVICE=sing-box
#SB_CONFIG_DIR=
# 片段文件名。sing-box 按文件名排序合并：00- 开头排在 config.json 前面，
# 我们那条「探测入站 → WARP」的规则会排在你所有规则之前，不会被别的规则截走
#FRAGMENT_NAME=00-warp-keeper.json

# ---------- 自愈 ----------
# 探测不通时：先重载 sing-box（所有入站会断开一下）→ 还不通就换新账户。
# 两次自动换号至少隔这么多分钟，避免网络抖动时反复注册（Cloudflare 那边也有频率限制）
RENEW_MIN_GAP=360

# ---------- WARP+ ----------
#   auto  从下面的 Telegram 频道抓最新的公开许可证，逐个试，套上为止；免费账户每天再试一次
#   off   只用免费账户
#   直接写许可证（xxxxxxxx-xxxxxxxx-xxxxxxxx，多个用空格隔开）
# 公开频道的许可证是很多人共用的：随时可能失效或设备数满，套不上就继续用免费的，不影响正常工作
WARP_PLUS=auto
#WARP_PLUS_CHANNEL=https://t.me/s/warpplus

# 下面的时间（日报几点发、消息里的时间）按这个时区算
TIMEZONE=Asia/Taipei

# ---------- Telegram ----------
# 两项都填才会发送（可以和 traffic-bot、cfst-ddns 用同一个 bot）
TG_BOT_TOKEN=
TG_CHAT_ID=
# change = 出问题、自愈、恢复时发，故障持续时每 TG_REPEAT_HOURS 小时提醒一次（默认）
# all    = 每次检查都发
# off    = 不发
TG_NOTIFY=change
TG_REPEAT_HOURS=6
# 每天几点发一条日报（可用率、延迟、换号次数），留空不发
TG_SUMMARY_HOUR=9

# ---------- Sonde 面板（可选）----------
# 填了就在每次检查后上报（出口只写机房代码和国家，没有 IP）
SONDE_URL=
SONDE_TOKEN=
