[Unit]
Description=Cloudflare 优选 IP 测速并更新 DNS
Wants=network-online.target
After=network-online.target

[Service]
# exec：systemctl start 启动后立即返回，不会卡在终端里；进度看 journalctl -fu cfst-ddns
Type=exec
EnvironmentFile=/etc/cfst-ddns.env
ExecStart=/opt/cfst-ddns/cfst-ddns.sh
# 卡死保护：一次运行超过 20 分钟就结束它（会发失败简报），下一轮 timer 照常触发
RuntimeMaxSec=20min
Nice=10

# 以固定 UID 的专用用户运行（由 install.sh 创建），sing-box TUN 用 exclude_uid 放行它直连
# 只能写 /var/lib/cfst-ddns
User=cfst-ddns
Group=cfst-ddns
StateDirectory=cfst-ddns
WorkingDirectory=/var/lib/cfst-ddns
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
