# /etc/cfst-ddns.env  （权限 600，只有 root 能读）
CLOUDFLARE_LABEL="🟠 Cloudflare"
CLOUDFRONT_LABEL="🔵 CloudFront"

# Cloudflare API Token：My Profile → API Tokens → Create Token → "Edit zone DNS" 模板，
# Zone Resources 只选这一个域名。不要用 Global API Key。
CF_API_TOKEN=

# 域名 Overview 页面右下角的 Zone ID
CF_ZONE_ID=

# Cloudflare 优选 IP 写到这条记录。会被脚本反复覆盖，建议专门建一个子域名，不要用其他服务在用的记录
CF_RECORD_NAME=cf.example.com

CF_TTL=60

# 要优选哪些 CDN，空格分隔，按顺序依次跑。每个目标各自测速、各自更新一条记录、各自的榜单和状态
#   cloudflare  用下面不带前缀的配置
#   cloudfront  用文件末尾 CLOUDFRONT_ 开头的配置，没写的项沿用全局配置
#   fastly      内置了官方 IP 列表地址，配法同 cloudfront（FASTLY_ 前缀）
#   其他 CDN    起个名字（如 gcore），配上 GCORE_IPLIST_URL / GCORE_IPLIST_JQ 等即可
TARGETS="cloudflare"

# ---------- 调度 ----------
# 三级流程，按需逐级升级：
#   巡检      只测当前在用的 1 个 IP。健康就结束；变差了 → 复测榜单
#   复测榜单  重测上次全量扫描留下的榜单（几十个 IP），选最好的；榜单全不达标 → 全量扫描
#   全量扫描  测约 6000 个 IP 的延迟，重建榜单，再测速选最好的
# timer 每 5 分钟检查一次，按下面的时间表决定做哪一级，不到时间就什么都不做。
# 手动跑某一级：systemctl start cfst-ddns@full（或 @check / @pool）

# 时区：下面所有时间按这个时区算，日志和简报里的时间也用它
TIMEZONE=Asia/Taipei

# 每天几点全量扫描，可写多个，空格分隔，例如 "04:00 18:30"。
# 放在晚高峰前，进入高峰时榜单是新的
FULL_AT=18:30

# 晚高峰时段 [开始点, 结束点)，24 = 午夜；跨午夜可写 "22-2"。留空 = 不区分时段
PEAK_HOURS=19-24
# 巡检间隔（分钟）：晚高峰 / 其余时间
PEAK_EVERY=30
OFFPEAK_EVERY=120

# 健康标准 %：当前 IP 速度 ≥ 基准 × 这个比例（且不低于 MIN_SPEED）就算健康。
#   基准 = 这个 IP 上次被选中或被确认留用时测到的速度
#   只看延迟时（RANK_BY=latency）：延迟 ≤ 基准延迟 ÷ 这个比例 算健康
HEALTH_RATIO=70
# 切换门槛 %：复测时新 IP 至少比当前 IP 快这么多（或当前 IP 已不达标）才切换，
# 避免在差不多的 IP 之间来回跳。设了 SPEED_TOLERANCE 时，速度相当、延迟低这么多也会切换
SWITCH_MARGIN=20
# 榜单全不达标时会补一次全量扫描；但距上次全量不到这么多分钟就不补，直接失败保留现有解析
#FULL_MIN_GAP=120

# ---------- 测速 ----------
# 按什么选 IP（RANK_BY）：
#   download  按下载速度（默认）。先测延迟，再挑一批用 cfst 做下载测速
#   upload    按上传速度。先测延迟，再挑一批用 curl 往 UPLOAD_URL 直连上传测速
#   latency   只看延迟和丢包，不测速（最快、最省流量）。选丢包最少、延迟最低的
RANK_BY=download

# 榜单（全量扫描时选出、之后复测用的那批 IP）：
#   LATENCY_SPLIT > 0（分段，推荐）：以这个延迟为界分成两段，每段各取 PICK_PER_GROUP 个
#       延迟最低的。适合"低延迟的是一条线路、高延迟的是另一条"的情况，例如 <150ms 走香港
#       （高峰拥堵）、≥150ms 走美国（带宽足）：两段一起比，谁快选谁。
#       日志和简报里每个 IP 会标出属于哪一段。
#   LATENCY_SPLIT = 0（不分段）：取延迟最低的 PICK_PER_GROUP 个。
#   榜单越大，复测越可能找到好的，但每次复测的耗时和流量也越多（约 个数 × 测速秒数）
LATENCY_SPLIT=150
PICK_PER_GROUP=5

# 速度底线 MB/s：总是选测过的 IP 里最快的那个（没有 5 MB/s 就用 4.9 的）；
# 只有连选中的都低于这个值时才放弃本次更新、保留现有解析。0 = 只排除速度为 0 的情况。
MIN_SPEED=1

# 速度容差 %：速度在最快的这个比例以内的，选延迟最低的那个。0 = 只看速度。
# 例如 15：最快 8 MB/s 时，≥ 6.8 MB/s 的里面谁延迟最低选谁。想兼顾速度和延迟就设 10~20。
SPEED_TOLERANCE=0

# 种子：别人已经筛过的优选 IP（公共优选域名、优选 IP 网页），作为官方扫描之外的补充候选。
#   - 不照搬别人的排名：种子和官方扫描出来的 IP 一起，在你的线路上重新测延迟、测速，谁快用谁
#   - 只保留落在官方网段内的 IP（公共域名可能被劫持/污染，混进来的别的 IP 直接丢弃）
#   - 每段给种子单独留 SEED_PICK_PER_GROUP 个测速名额，和官方的 PICK_PER_GROUP 分开算，
#     保证每轮两边都有人参赛；日志、简报里会写「官方最佳 vs 种子最佳」，跑几天后用
#     /opt/cfst-ddns/cfst-ddns.sh stats 看汇总（分晚高峰 / 非高峰）
#   - 复测榜单和全量扫描时采集（每次都是最新的），巡检不用
#   SEEDS_DNS  优选域名，空格分隔。用 SEED_DOH 直连解析（避开 sing-box 的 fakeip，拿到你所在运营商的线路）
#   SEEDS_URL  网页或接口地址，空格分隔，抓取返回内容里所有的 IPv4
# 下面这些是第三方公共来源，可用性不作保证，按需启用：
#SEEDS_DNS="cf.090227.xyz cloudflare.182682.xyz bestcf.top"
#SEEDS_URL="https://www.wetest.vip/page/cloudflare/address_v4.html https://www.wetest.vip/page/cloudflare/total_v4.html"
#SEED_PICK_PER_GROUP=3
#SEED_DOH=https://dns.alidns.com/resolve
# 不在官方网段的种子默认丢弃。它们多半是第三方「反代 IP」：不是该 CDN 自己的节点，而是别人的服务器
# 转发到 CDN。能用，但你的流量会先经过一个不认识的人（看不到 TLS 内容，但看得到你连了哪个域名、
# 流量多少，也随时可能下线）。想保留就设 1，日志和统计里会标「(段外)」，可以和官方的比一比
#SEED_ALLOW_OUTSIDE=0

# 上传测速（RANK_BY=upload 时生效）
#   UPLOAD_URL  接受 POST 的地址，必须在 CF 上（橙云）。每个候选 IP 会用 --resolve 钉到这个
#               域名上直连上传，不查 DNS、不走代理。默认是 Cloudflare 自己的测速接口，
#               不保证一直可用；不稳定时换成自建的 Worker（README 里有现成代码）
#   UP_SECONDS  每个 IP 上传几秒。越长越准；流量约 个数 × 秒数 × 你的上行速度
#UPLOAD_URL=https://speed.cloudflare.com/__up
#UP_SECONDS=5

# cfst 参数（不要写 -f / -o / -p，脚本会自己加）
#   -tl 250   延迟上限 ms，超过的 IP 直接淘汰（要比你较慢那条线路的延迟高）。所有模式都生效
#   -tlr 0.2  丢包率上限，0 = 有丢包就淘汰。所有模式都生效
#   -n 100    延迟测速并发数（默认 200）。调小发包更平缓，全量扫描会慢一些
#   -dt 5     每个 IP 下载测速几秒（download 模式）
#   -dn       不用写，测几个 IP 由榜单大小决定
#   -url URL  下载测速地址（download 模式）；速度全是 0 时换成你自己挂在 CF 后面的大文件
#   -sl 5     下载速度下限 MB/s。不建议用：cfst 会在全部候选里逐个测，直到凑够 -dn 个达标的，
#             高峰期可能测几十分钟；一个都不达标时什么结果都不输出。速度底线请用上面的 MIN_SPEED。
CFST_ARGS="-tl 250 -dt 5"

# 可选：测 IPv6 时改成 /opt/cfst-ddns/ipv6.txt，记录会自动用 AAAA
#CFST_IPFILE=/opt/cfst-ddns/ip.txt

# 测速期间每隔多少秒往日志打一行进度
#PROGRESS_EVERY=15

# ---------- 网络 ----------
# cfst 测速必须直连（靠 sing-box TUN 的 exclude_uid 放行），但同一个用户发出的
# Cloudflare API 和 Telegram 请求也会被一起排除在 TUN 之外。
# 填一个本机代理入口（sing-box 的 mixed/socks inbound），这两类请求就改走代理；
# 用 socks5h:// 让域名也交给代理解析，避开 fakeip。留空则直连。
#API_PROXY=socks5h://127.0.0.1:2080

# ---------- Telegram 简报 ----------
# 两项都填才会发送。chat_id 可以给 bot 发条消息后在
# https://api.telegram.org/bot<TOKEN>/getUpdates 里找到。
TG_BOT_TOKEN=
TG_CHAT_ID=
# all=每次运行都发  change=只在 IP 变化或失败时发  off=不发
TG_NOTIFY=all
# 巡检结果正常（当前 IP 健康、什么都没改）时要不要发：on=发  off=不发
# 晚高峰每 30 分钟巡检一次，开着会比较多；巡检发现变差、换 IP、失败时不受这个开关影响
TG_NOTIFY_CHECK=off

# ========== CloudFront（TARGETS 里加上 cloudfront 才生效）==========
# 规则：<前缀>_XXX 覆盖全局的 XXX（调度、测速、简报的配置都可以单独设）。下面这几项不继承全局，要单独写：
#   RECORD_NAME、CFST_ARGS、UPLOAD_URL、IPFILE / IPLIST_URL / IPLIST_JQ / IP_EXCLUDE / IP_SAMPLE、SEEDS_DNS / SEEDS_URL
#   RANK_BY（测速方向跟着这个 CDN 承担的那一段走，不写默认 download）
#
# 写到这条记录（同一个 CF_ZONE_ID 里；别的域名可以用 CLOUDFRONT_ZONE_ID 单独指定）。
# 用你自己域名下一个新的专用子域名：脚本会把它设成 A 记录，如果同名已经有 CNAME，API 会报冲突。
# 别用 cloudfront.182682.xyz 这类公共优选域名——那是别人的域名，你改不了
#CLOUDFRONT_RECORD_NAME=cfr.example.com
#
# 必须用 -url 指定一个你自己分发上的测速文件：cfst 默认的测速地址在 Cloudflare 上，CloudFront 节点不认。
# 测速流量会计入你 AWS 账号的 CloudFront 流量（见 README「CloudFront」一节）
# 按什么选 IP：download / upload / latency。比如上下行分离时 Cloudflare 走上行用 upload、
# CloudFront 走下行用 download，各写各的，互不影响
#CLOUDFRONT_RANK_BY=download
#
#CLOUDFRONT_CFST_ARGS="-tl 300 -dt 5 -url https://xxxx.cloudfront.net/cfst/50mb.bin"
#
# 以下都有内置默认值，一般不用改：
#   IP 列表：每天从 AWS 官方地址更新，只取边缘节点（CLOUDFRONT_GLOBAL_IP_LIST）
#CLOUDFRONT_IPLIST_URL=https://d7uri8nf7uskq.cloudfront.net/tools/list-cloudfront-ips
#CLOUDFRONT_IPLIST_JQ='.CLOUDFRONT_GLOBAL_IP_LIST[]'
#   排除中国大陆节点（正则，按网段开头匹配）：海外账号的分发在这些节点上用不了，但延迟最低，会占满榜单
#CLOUDFRONT_IP_EXCLUDE='^(52\.82\.|111\.13\.|116\.129\.|118\.193\.|119\.147\.|120\.52\.|120\.232\.|120\.253\.|180\.163\.|58\.254\.|36\.103\.)'
#   列表约 1.6 万个 /24，每次全量随机抽这么多个测（每天换一批；上一轮榜单里的 IP 总会一起测）
#CLOUDFRONT_IP_SAMPLE=4000
#
# 种子（第三方公共来源，按需启用；不继承上面 Cloudflare 的种子）
#CLOUDFRONT_SEEDS_DNS="cloudfront.182682.xyz"
#CLOUDFRONT_SEEDS_URL="https://www.wetest.vip/page/cloudfront/address_v4.html https://www.wetest.vip/page/cloudfront/total_v4.html"
#
# 其他可按需覆盖的，例如：
#CLOUDFRONT_LATENCY_SPLIT=0
#CLOUDFRONT_PICK_PER_GROUP=5
#CLOUDFRONT_OFFPEAK_EVERY=240
