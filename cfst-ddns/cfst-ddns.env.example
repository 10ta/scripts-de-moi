# /etc/cfst-ddns.env  （权限 600，只有 root 能读）

# Cloudflare API Token：My Profile → API Tokens → Create Token → "Edit zone DNS" 模板，
# Zone Resources 只选这一个域名。不要用 Global API Key。
CF_API_TOKEN=

# 域名 Overview 页面右下角的 Zone ID
CF_ZONE_ID=

# 会被脚本反复覆盖的记录，建议专门建一个子域名，不要用其他服务在用的记录
CF_RECORD_NAME=cf.example.com

CF_TTL=60

# ---------- 测速 ----------
# 流程：先测约 6000 个 IP 的延迟（1~2 分钟），再挑一批做下载测速，
#       结果按下载速度排序，取第一名写进 DNS。
#
# 挑哪些做下载测速：
#   LATENCY_SPLIT > 0（分段，推荐）：以这个延迟为界分成两段，每段各取 PICK_PER_GROUP 个
#       延迟最低的。适合"低延迟的是一条线路、高延迟的是另一条"的情况，例如 <150ms 走香港
#       （高峰拥堵）、≥150ms 走美国（带宽足）：高峰期自然选美国，闲时香港更快就选香港。
#       日志和简报里每个 IP 会标出属于哪一段。
#   LATENCY_SPLIT = 0（不分段）：直接取延迟最低的 -dn 个。
LATENCY_SPLIT=150
PICK_PER_GROUP=5
#
# cfst 参数（不要写 -f / -o / -p，脚本会自己加）
#   -tl 250   延迟上限 ms，超过的 IP 直接淘汰（要比你较慢那条线路的延迟高）
#   -dn 10    不分段时下载测速几个 IP；分段时由脚本按 2 × PICK_PER_GROUP 设置，这里写了也不生效
#             越多越可能挑到快的，耗时和流量也越多（约 个数 × -dt 秒）
#   -dt 5     每个 IP 下载测速几秒
#   -url URL  下载测速地址；默认地址挂了（速度全是 0）时换成你自己挂在 CF 后面的大文件
#   -dd       不做下载测速，只按延迟选（最省流量）
#   -sl 5     下载速度下限 MB/s。不建议用：cfst 会在全部候选里逐个测，直到凑够 -dn 个达标的，
#             高峰期可能测几十分钟；一个都不达标时什么结果都不输出。速度底线请用下面的 MIN_SPEED。
CFST_ARGS="-tl 250 -dn 10 -dt 5"

# 速度底线 MB/s：总是选测过的 IP 里最快的那个（没有 5 MB/s 就用 4.9 的）；
# 只有连最快的都低于这个值时才放弃本次更新、保留现有解析。0 = 只排除速度为 0 的情况。
MIN_SPEED=1

# 可选：测 IPv6 时改成 /opt/cfst-ddns/ipv6.txt，记录会自动用 AAAA
#CFST_IPFILE=/opt/cfst-ddns/ip.txt

# 测速期间每隔多少秒往日志打一行进度
#PROGRESS_EVERY=15

# ---------- 网络 ----------
# cfst 测速必须直连（靠 sing-box TUN 的 exclude_uid 放行），但同一个用户发出的
# Cloudflare API 和 Telegram 请求也会被一起排除在 TUN 之外。
# 填一个本机代理入口（sing-box 的 mixed/socks inbound），这两类请求就改走代理；
# 用 socks5h:// 让域名也交给代理解析，避开 fakeip。留空则直连。
#API_PROXY=socks5h://127.0.0.1:2080

# ---------- Telegram 简报 ----------
# 两项都填才会发送。chat_id 可以给 bot 发条消息后在
# https://api.telegram.org/bot<TOKEN>/getUpdates 里找到。
TG_BOT_TOKEN=
TG_CHAT_ID=
# all=每次运行都发  change=只在 IP 变化或失败时发  off=不发
TG_NOTIFY=all
